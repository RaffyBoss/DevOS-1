# DevOS environment template
# Copy to .env and fill in before running.

# Core
APP_NAME=DevOS
DEBUG=false
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000

# Required: keep this secret and stable across restarts.
JWT_SECRET=
ENV=production

# Auth mode: local | supabase | dual
AUTH_MODE=dual

# Supabase (optional when AUTH_MODE=local)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_JWT_SECRET=

# Admin bootstrap
ADMIN_USER=admin
ADMIN_EMAIL=admin@devos.local
ADMIN_PASSWORD=

# Database
# For SQLite (default): DATABASE_URL is auto-computed from PROJECT_ROOT if not set here.
# For Postgres: set this to the connection string (e.g., postgresql+asyncpg://user:pass@host/db)
DATABASE_URL=sqlite+aiosqlite:///./data/devos.db

# LLM providers (fill at least one)
DEFAULT_PROVIDER=ollama
OLLAMA_HOST=https://ollama.carai.agency
OLLAMA_DEFAULT_MODEL=llama3
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
HUGGINGFACE_API_KEY=
NARAROUTER_API_KEY=

# Search
TAVILY_API_KEY=
SEARXNG_URL=http://localhost:8080

# Memory / integrations
CHROMADB_HOST=localhost
CHROMADB_PORT=8100
ENCRYPTION_KEY=

# Notifications
NTFY_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
